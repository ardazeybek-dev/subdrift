<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);FS3390</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Subtitle.fs" />
    <Compile Include="Signal.fs" />
    <Compile Include="Fft.fs" />
    <Compile Include="Audio.fs" />
    <Compile Include="Align.fs" />
    <Compile Include="Synth.fs" />
    <Compile Include="Report.fs" />
    <EmbeddedResource Include="report.html" LogicalName="Subdrift.Core.report.html" />
  </ItemGroup>

</Project>
