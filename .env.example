# subdrift configuration — copy to .env and adjust.
# Precedence: command-line flag > environment variable > .env > built-in default.

# Path to ffmpeg, used to read audio from video files (mkv, mp4, ...).
# Not needed for .wav or subtitle references.
SUBDRIFT_FFMPEG=ffmpeg

# Encoding tried when a subtitle is not valid UTF-8.
# windows-1252 (Western), windows-1254 (Turkish), windows-1251 (Cyrillic), windows-1256 (Arabic), ...
SUBDRIFT_FALLBACK_ENCODING=windows-1252

# Largest constant offset to search, in seconds (both directions).
SUBDRIFT_MAX_OFFSET=120

# Cost of one scene jump, in seconds of matched speech. Raise it if subdrift
# splits files that have no cuts; lower it to catch short removed scenes.
SUBDRIFT_SPLIT_PENALTY=6

# Largest extra shift a single scene may receive, in seconds.
SUBDRIFT_MAX_SPLIT=60

# Speech threshold between the noise floor (0) and loud speech (1).
# Lower it for quiet dialogue, raise it for noisy action scenes.
SUBDRIFT_VAD_THRESHOLD=0.35

# Set to any value to disable colored output.
# NO_COLOR=1
